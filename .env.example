# Runtime variables. Nothing here is a build input: `npm run build` and the
# Docker builder need no database and no secrets (ADR 0003). Copy this file to
# `.env` and fill it in; `.env` is gitignored and `.dockerignore` keeps it out of
# the image, so Compose injects it at runtime instead.

# Postgres connection string. Required: without it the first request that reads
# clinical data fails by name.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sshp?schema=public

# Secret Better Auth signs session cookies with. Required, and it must be a
# strong random value: `npx auth secret` or `openssl rand -base64 32`. Without
# one the first sign-in or session read fails by name. AUTH_SECRET is accepted
# as a legacy fallback.
BETTER_AUTH_SECRET=

# Canonical app URL. Better Auth derives the origin from the incoming request
# when this is unset, which breaks callbacks and redirects.
BETTER_AUTH_URL=http://localhost:3000
